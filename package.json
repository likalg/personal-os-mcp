{
  "name": "personal-os-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP adapter for the Personal OS AI API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "personal-os-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.2.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.16.5",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
